{
  "id": "pathology-foundation",
  "name": "Pathology Foundation Models",
  "author": "xOpat",
  "version": "0.2.0",
  "description": "Broker that runs named pathology jobs on the active viewport. Ships a built-in, dependency-free tissue detector (works out of the box, nothing leaves the viewer) and lets drivers register per feature (tissue-mask / segment / analyze). Exposes the `pathology` scripting namespace for LLM/agent use.",
  "requires": ["annotations"],
  "sessionCompatible": false,
  // When true, remote-driver consent is asked on EVERY call instead of once per
  // driver+feature per session. Deployment (ENV) knob — read via static meta.
  "alwaysAskRemoteConsent": false,
  // Vocabulary used to DERIVE the slide's stain and specimen site from
  // patient-sensitive sources (metadata fields, file name, channel names) when the
  // caller supplies no explicit context.
  //
  // SAFETY: this is an ALLOWLIST OF OUTPUT, not a filter of input. Only a `label`
  // from an entry matched below can ever reach a model prompt — text that matches
  // nothing is never emitted at all, so patient names, dates and identifiers in a
  // file name are structurally incapable of leaking, however long this list grows.
  // Never emit raw metadata values here.
  //
  // `class` is the stain's SIGNAL class and decides what the model is allowed to
  // claim: "histochemical" (morphology/tinctorial only — licenses no named target),
  // "targeted" / "fluorescence" (licenses ONLY the listed `targets`), "unstained".
  // An entry with a targeted class but no targets degrades to "unknown" (claims
  // nothing) — that is deliberate.
  //
  // Extend this per deployment via ENV.modules["pathology-foundation"] instead of
  // patching the module. `match` entries are case-insensitive whole-token matches.
  // An EXPLICIT context passed to buildOverview bypasses this list entirely — a
  // human naming a stain nobody anticipated is always authoritative.
  "contextVocabulary": {
    "stains": [
      { "match": ["h&e", "he", "hne", "hematoxylin", "haematoxylin"], "label": "H&E", "class": "histochemical" },
      { "match": ["pas"], "label": "PAS", "class": "histochemical" },
      { "match": ["masson", "trichrome"], "label": "Masson trichrome", "class": "histochemical" },
      { "match": ["giemsa"], "label": "Giemsa", "class": "histochemical" },
      { "match": ["ihc"], "label": "IHC", "class": "targeted" },
      { "match": ["if", "immunofluorescence"], "label": "Immunofluorescence", "class": "fluorescence" },
      { "match": ["unstained", "labelfree", "label-free"], "label": "unstained", "class": "unstained" }
    ],
    "organs": [
      { "match": ["lung", "pulmonary"], "label": "lung" },
      { "match": ["breast", "mamma"], "label": "breast" },
      { "match": ["colon", "colorectal"], "label": "colon" },
      { "match": ["prostate"], "label": "prostate" },
      { "match": ["liver", "hepatic"], "label": "liver" },
      { "match": ["kidney", "renal"], "label": "kidney" },
      { "match": ["skin", "cutaneous"], "label": "skin" },
      { "match": ["lymph", "lymphnode"], "label": "lymph node" },
      { "match": ["stomach", "gastric"], "label": "stomach" },
      { "match": ["pancreas", "pancreatic"], "label": "pancreas" },
      { "match": ["brain"], "label": "brain" },
      { "match": ["thyroid"], "label": "thyroid" },
      { "match": ["bladder"], "label": "bladder" },
      { "match": ["ovary", "ovarian"], "label": "ovary" },
      { "match": ["uterus", "endometrium", "cervix"], "label": "uterus" },
      { "match": ["bone", "marrow"], "label": "bone marrow" },
      { "match": ["esophagus", "oesophagus"], "label": "esophagus" }
    ]
  },
  // Traversal strategy for buildOverview. "best-first" (default) surveys every
  // tissue region once out of a reserved share of the call budget, then spends the
  // rest on the globally most promising regions. "dfs" is the previous depth-first
  // walk, kept for one release as an escape hatch: it explores the first island to
  // exhaustion and can leave later ones unvisited.
  //
  // A DEPLOYMENT knob, read via static meta — not something an imported session
  // bundle may change.
  // "scheduler": "best-first",

  // When two region boxes stop being two regions. A region is the bounding box of a
  // traced tissue contour, and a contour that is not a compact blob (a curved biopsy
  // strip, a folded core, a ribbon of mucosa) yields a box holding much of its
  // neighbour — so without this the same tissue is rendered, sent to a vision model
  // and reported as several separate findings. Either test merges: `iou` (the boxes
  // are largely the same box) or `containment` (one is almost entirely inside the
  // other, at any size ratio).
  //
  // Set to false to keep every traced box as its own region. A DEPLOYMENT knob for the
  // same reason `scheduler` is: it decides what a region IS, and the survey it shapes
  // is cached and shared by later calls.
  // "regionMerge": { "iou": 0.4, "containment": 0.9 },

  // How regions are NUMBERED. "reading" (default) counts them the way a reviewer counts
  // fragments off the glass — rows top to bottom, left to right within a row — so "region 3"
  // is the third piece on the slide and a list of region links walks it in order. "area"
  // restores the previous numbering, which was the tissue-size rank and had "region 1"
  // landing on whichever island happened to be biggest.
  //
  // Naming only: what gets rendered, read and expanded is still decided by tissue area,
  // fill and cellularity. A DEPLOYMENT knob, because a label is what a plan edit and a
  // region link address, and the survey carrying them is cached and shared.
  // "regionOrder": "reading",

  // Render budgets, in ms. Clamped to 500..300000. DEPLOYMENT knobs: they decide how long
  // the viewer waits on a tile backend, so a session bundle must not be able to set them.
  //
  // The defaults assume a tile server on the same network. A WAN-hosted store usually wants
  // all three raised — the symptom of leaving them too low is every field coming back
  // `reason: "unread"`, which looks like an unreadable slide but is a latency problem.
  //
  //   fieldLoadTimeoutMs   tile loading for ONE field, once its render is running. Spending
  //                        it is not a failure: the partial raster is returned and reported
  //                        as incomplete.
  //   surveyLoadTimeoutMs  the same, for the whole-slide survey — one render whose coverage
  //                        decides the entire walk, so it gets a generous budget.
  //   renderQueueTimeoutMs the wait for a TURN. Off-screen passes are serialized per viewer
  //                        and admitted through the background request scheduler; neither
  //                        wait is bounded by the two above. Spending this one IS a failure,
  //                        reported as a congested queue rather than an unreadable region.
  // "fieldLoadTimeoutMs": 6000,
  // "surveyLoadTimeoutMs": 15000,
  // "renderQueueTimeoutMs": 20000,

  // Absorbance vectors of the stain basis used to unmix the NUCLEAR stain, which is
  // how the module derives its free "where are the nuclei" prior (feature
  // "cellularity"). A COLOUR BASIS, not a clinical vocabulary: `nuclear` is the
  // counterstain whose concentration is measured, `counter` is the other stain, and
  // `third` completes the basis (the orthogonal residual when omitted).
  //
  // The defaults are the standard Ruifrok-Johnston H&E-DAB values and are used when
  // this key is absent. Override per deployment for a slide whose stains are not in
  // that basis. A stain class where unmixing is meaningless (fluorescence, unstained)
  // ignores this entirely and falls back to saturation.
  //
  // "stainVectors": {
  //   "nuclear": [0.650, 0.704, 0.286],
  //   "counter": [0.072, 0.990, 0.105],
  //   "third":   [0.268, 0.570, 0.776]
  // },
  "defaultDrivers": {
    // Optional per-feature default driver overrides, e.g. { "analyze": "vlm-sdk" }.
    // When a feature has no override the first registered capable driver wins;
    // for "tissue-mask" that is the always-present built-in detector unless you
    // register a replacement here.
  },
  "drivers": {
    // Register foundation models here. Each entry is one driver, keyed by the
    // FEATURE it implements. `proxyAlias` keeps upstream credentials on the
    // server (see server.secure.proxies.<alias>); use `baseURL` for an absolute
    // endpoint. Other modules/plugins (e.g. the SAM tool) register additional
    // drivers at runtime.
    //
    // Image -> mask endpoint. `feature` picks which job it serves:
    //   "segment"     (default) prompt/point-driven region mask, or
    //   "tissue-mask" to override the built-in tissue detector.
    // Response shape: { binary_mask: <base64>, width, height, label?, score? }.
    // "tissue-seg": {
    //   "type": "http", "feature": "tissue-mask",
    //   "proxyAlias": "pathology-seg", "path": "segment",
    //   "label": "Tissue segmentation (server)"
    // },
    //
    // Vision -> text analysis through the Vercel AI SDK (reaches any provider
    // the SDK adapts). Runs in a context ISOLATED from the chat agent;
    // `providerId` MUST name a DEDICATED pathology provider from the chat
    // registry, never the agent's provider. It is a provider REFERENCE — an
    // instance id, a managed key ("<plugin>:<type>:default"), a plugin id or a
    // provider type id. Prefer the plugin id: managed instance ids are re-minted
    // on every server start and cannot be written into config at all:
    // "vlm-sdk": {
    //   "type": "vercel",
    //   "providerId": "pathology-medgemma",
    //   "model": "medgemma-4b-it", "label": "MedGemma (SDK)"
    // }
  }
}

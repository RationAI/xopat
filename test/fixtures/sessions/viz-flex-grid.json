            },
            "threshold": {
              "type": "advanced_slider",
              "breaks": [
                0.15,
                0.4,
                0.7
              ]
            },
            "connect": true
          }
        },
        "detection": {
          "name": "Detection score",
          "type": "heatmap",
          "visible": 0,
          "fixed": false,
          "dataReferences": [
            1
          ],
          "params": {
            "use_channel0": "g"
          }
        },
        "grid": {
          "name": "Prediction grid (512 px)",
          "type": "grid",
          "visible": 1,
          "fixed": false,
          "dataReferences": [
            0
          ],
          "params": {
            "color": "#ffffff",
            "cell_x": 512,
            "cell_y": 512,
            "line_width": 1,
            "adaptive_lod": false
          }
        }
      }
    }
  ]
}

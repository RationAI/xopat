{
  "params": {
    "customBlending": true,
    "sessionName": "viz-flex-grid"
  },
  "data": [
    "slides/slide.tif",
    {
      "dataID": "generated/grid/mask-grid.json",
      "protocol": "demo-static",
      "imageSmoothingEnabled": false,
      "pixelScale": 512
    }
  ],
  "background": [
    {
      "dataReference": 0,
      "visualizationIndex": 0,
      "name": "H&E slide"
    }
  ],
  "visualizations": [

{
  "id": "rationai-wsi-file-browser",
  "name": "%meta.name%",
  "author": "Vendula Penazova",
  "version": "1.0.0",
  "description": "%meta.description%",
  "categories": ["Navigation"],
  "keywords": ["wsi", "browser", "files", "rationai"],
  "icon": "ph-folder-open",
  "includes": [
    "file-browser.js"
  ],
  "requiredConfig": ["wsiService"],
  "modules": ["rationai-wsi-tile-source"],
  // RationAI WSI Service URL. Unused when `proxy` is set.
  "wsiService": "http://localhost:8080",
  // Server proxy alias (`core.server.secure.proxies.<alias>`) to route the
  // listing through instead of calling `wsiService` directly. With it every
  // request travels `/proxy/<alias>/v3/...` on the viewer origin, so the
  // upstream needs no CORS and its origin never reaches the browser.
  "proxy": null
}

    "../../node_modules/@cornerstonejs/codec-charls/dist/charlswasm_decode.wasm": "dist/",
    "../../node_modules/@cornerstonejs/codec-libjpeg-turbo-8bit/dist/libjpegturbowasm_decode.wasm": "dist/"

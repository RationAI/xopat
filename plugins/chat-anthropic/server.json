{
  "requiredConfig": ["providerDefaults.baseUrl"],
  "providerDefaults": {
    "id": "anthropic-claude",
    "label": "Anthropic",
    "description": "Anthropic Claude API endpoint",
    "baseUrl": "https://api.anthropic.com/v1",
    // Three-state, see anthropic-host.server.ts: a string is the operator key,
    // "" means "a key is required but none is configured" (model discovery stays
    // off, the panel shows the BYOK hint), `false` declares the endpoint keyless.
    // NEVER ship a placeholder string here — it is indistinguishable from a real
    // key to `missingRequiredSecrets`, so discovery runs and 401s upstream.
    "apiKey": "",
    "defaultModelId": "",
    "modelsPath": "/models",
    "anthropicVersion": "2023-06-01"
  }
}

{
  "id": "chat-openai-compatible",
  "name": "%meta.name%",
  "author": "RationAI",
  "version": "1.0.0",
  "description": "%meta.description%",
  "categories": ["AI"],
  "keywords": ["chat", "llm", "openai", "gpt"],
  "icon": "ph-chat-circle-dots",
  "modules": ["vercel-ai-chat-sdk"],
  // Login is OPT-IN and method-agnostic. "none" (default) works out of the box;
  // any other value requires login for `authContext` and secures the viewer (RPC)
  // endpoint, NOT the upstream model.
  "authMode": "none",
  // Null/"core" = the viewer's main auth context. Whichever auth module owns that
  // context (oidc-client-ts, saml-auth, …) supplies the mechanism — this plugin
  // never names one. Point it at a dedicated context only if the deployment
  // authenticates the chat separately from the viewer.
  "authContext": null
  // Back-compat escape hatch when the auth config lives on the plugin instead of
  // on an auth module — applied ONLY if no auth module claims `authContext`:
  //   "authBroker": "oidc",
  //   "authConfig": { "authority": "...", "client_id": "...", "scope": "..." }
}

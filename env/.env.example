# Secrets and deployment-local values for `npm run up`.
#
# Copy to `env/.env` (gitignored) and fill in what your configuration needs.
# The runner injects these into the server process; the server itself resolves
# `<% VAR %>` placeholders inside the ENV file against its process environment
# (server/templates/javascript/core.js), which is why no secret ever has to be
# written into a configuration file.
#
# Precedence, lowest to highest:
#   fragment `$meta.defaults` → preset `env` block → env/.env → your shell
# so `ANTHROPIC_API_KEY=… npm run up -- chat` always wins over this file.
#
# `npm run up:check -- <selectors>` reports which of these a composition needs
# and which are still unset.

# ── LLM providers ────────────────────────────────────────────────────────────
# chat/anthropic-server-key — server-held key, never reaches the browser
ANTHROPIC_API_KEY=
# chat/openai-server-key
OPENAI_API_KEY=
# chat/openai-compatible-cerit — OpenAI-compatible endpoint at CERIT
CERIT_API_KEY=
# pathology-medgemma — self-hosted MedGemma inference endpoint
MEDGEMMA_API_KEY=
MEDGEMMA_BASE_URL=

# ── Identity providers ───────────────────────────────────────────────────────
# idp/google — client id is public, the secret is not (confidential/server flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# auth/saml — signing key for the session token the SP issues
# (referenced indirectly: the ENV names the *variable*, never the value)
XOPAT_SAML_JWT_SECRET=
# auth/saml with a custom service-provider certificate
SAML_SP_CERT=
SAML_SP_KEY=

# ── Data sources ─────────────────────────────────────────────────────────────
# data/wsi-service — host port of the local wsi-service container.
# docker/wsi-service/docker-compose.yml publishes 9002:8080, so with that
# compose file this is 9002; a wsi-service you run yourself is usually 8080.
WSI_PORT=9002
# data/dicomweb-google — the store's dicomWeb endpoint, e.g.
#   https://healthcare.googleapis.com/v1/projects/<p>/locations/<l>/datasets/<d>/dicomStores/<s>/dicomWeb
GOOGLE_DICOM_SERVICE_URL=
# data/dicomweb-google reached through the server proxy instead of a login
XOPAT_GOOGLE_HEALTHCARE_TOKEN=
# data/tiff-* — where `npm run fixtures:serve` serves the fixture data
# (server/utils/node/slide-fileserver.mjs; root defaults to test/fixtures/data,
# override with XOPAT_SLIDE_ROOT to serve scans from elsewhere)
TIFF_FILESERVER=http://127.0.0.1:9100/files
# deployments addressed by an external URI (LSAI/BBMRI, EMPAIA workbench)
XO_URI=

# ── IO sinks ─────────────────────────────────────────────────────────────────
# io/github — PAT with repo scope on the annotation storage repository
GITHUB_TOKEN=
GITHUB_SINK_REPO=owner/repository
# io/mlflow
MLFLOW_TOKEN=

# ── Server runtime ───────────────────────────────────────────────────────────
XOPAT_NODE_PORT=9000
# Required whenever an upstream (Keycloak, a local IdP) is on a private address:
# the SSRF guard blocks those by default. See server/README.md.
XOPAT_SSRF_ALLOWED_HOSTS=

{
  "$meta": {
    "description": "visualization-flexibility showcase — vector layers and derived mask geometries; layer over data/tiff-webtiff",
    "clientKey": "localhost",
    /* Deliberately dimensionless (no `dimension` key) so it STACKS on top of a
       `data` fragment rather than competing with one — a one-option dimension
       would make `npm run up` ask a question with no "none" answer.
       Layer it over `data/tiff-webtiff`, which is what decodes the slides and
       what sets `webGlPrecision`; the `viz-flex-demo` preset does exactly that.
       (`$meta.requires` is not the place to say so — it lists required
       environment VARIABLES, not layers.)

       No TIFF_FILESERVER default — see the note in `data/tiff-webtiff.json`:
       `$meta.defaults` values are never substituted, so the default belongs in
       the ENV body, and it is relative so it follows the bound port. */
  },
  /**
   * Run order:
   *
   *   npm run fixtures:derive  derive the vector/grid/mask artifacts from the
   *                          real prediction masks in test/fixtures/data/slides/
   *   npm run up -- viz-flex-demo
   *
   * No separate file server: `data/tiff-webtiff` (which this layers over) opts
   * the fixture directory into `core.server.media`, so the viewer serves the
   * derived artifacts itself with `Range` support. Data outside the repository
   * still needs `npm run fixtures:serve` — see that fragment's note.
   *
   * `webGlPrecision: "auto"` is NOT restated here — `data/tiff-webtiff` already
   * sets it and `requires` states the dependency. Neither is
   * `syntheticPreviewLevel`, which defaults to true in `src/config.json`.
   */
  "core": {
    "client": {
      "localhost": {
        "slide_protocols": {
          /**
           * Plain URL template for everything that is NOT decoded by webtiff:
           * the GeoJSON descriptor and the single-level grid mask. Both are
           * picked up by OpenSeadragon's own autodetection — `determineType`
           * tests `supports` on each candidate's prototype, so pointing at the
           * descriptor URL is all it takes.
           *
           * MVT is the one thing that cannot go through here: its tile source
           * derives a square world from the zoom range, which cannot describe a
           * non-square slide. That is what `modules/demo-vector-layers`
           * registers the `demo-mvt` factory protocol for.
           */
          /* ABSOLUTE, unlike the decoders' `protocolBaseUrl`, and it has to be.
             These descriptors name their payload with a URL relative to
             themselves (`"url": "masks.geojson"`, `"{z}/{x}/{y}.pbf"`), which
             the tile source resolves as `new URL(inner, descriptorUrl)` — and
             that constructor throws on ANY relative base, whatever the inner
             value looks like. A root-relative base therefore fails every vector
             session with `invalid url`.

             Built from `XOPAT_NODE_PORT` in the ENV body, where substitution
             runs, exactly as `data/synthetic-dzi` does it — and deliberately NOT
             through a `<% TIFF_FILESERVER:-… %>` default, because an inline
             default cannot itself contain a token: the grammar stops at the
             first `%>`. These are the repo's own derived artifacts served by the
             viewer, so there is no external-server case to keep an override for;
             point `--set` at the protocol if you need one. */
          "demo-static": "`http://localhost:<% XOPAT_NODE_PORT:-9000 %>/test/fixtures/data/${data}`"
        }
      }
    },
    /**
     * The six showcase sessions, printed as open-me URLs by the server at
     * startup — published *from* `test/fixtures/sessions/index.json` rather than
     * relisted here. The index already records each session's title, group,
     * prerequisites and what it demonstrates, and it is what
     * `npm run fixtures:urls`, the docs generator and `test/MANUAL_TESTING.md`
     * read; six hand-copied records restated the titles, dropped the
     * descriptions, and were one more place to forget when a session is added.
     *
     * All six need `npm run fixtures:derive`; the banner prints that per entry.
     */
    "server": { "secure": { "examples": {
      "viz-flex-sessions": {
        "sessionIndex": "test/fixtures/sessions/index.json",
        "group": "viz-flex",
        "order": 20
      }
    }}}
  },
  "modules": {
    "demo-vector-layers": {
      "enabled": true,
      "permaLoad": true,
      /* Absolute for the same reason as `demo-static` above: this module builds
         descriptor URLs, and the descriptors resolve their payload against
         themselves. A relative base makes `new URL` throw. */
      "protocolBaseUrl": "http://localhost:<% XOPAT_NODE_PORT:-9000 %>/test/fixtures/data"
    }
  }
}

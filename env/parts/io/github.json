{
  "$meta": {
    "description": "Annotation bundles round-trip to a GitHub repository",
    "env": {
      "GITHUB_SINK_REPO": "owner/repo the annotation bundles are written to",
      "GITHUB_TOKEN": "GitHub token with contents write access to the sink repository",
      "XOPAT_SLIDE_HASH_KEY": "Secret keying {slideHash} in stored paths; any long random string. Changing it re-addresses every stored slide file"
    },
    "dimension": "io",
    "requires": ["GITHUB_TOKEN", "GITHUB_SINK_REPO", "XOPAT_SLIDE_HASH_KEY"]
  },
  /**
   * The PAT lives ONLY in the server-side proxy header, so the browser never
   * sees it: the sink calls `/proxy/github/…` and the server attaches the
   * credential. `auth.enabled: false` means the viewer need not be logged in;
   * flip it to require a login before anything is proxied.
   *
   * That `enabled: false` is load-bearing, and it is a real trade-off: the server
   * refuses a credential-bearing alias with no verifier unless the operator says
   * so explicitly, precisely because session + CSRF only prove same-origin — any
   * visitor of this deployment can spend the PAT through `/proxy/github/…`. It is
   * acceptable for a local dev deployment; for anything shared, set
   * `"enabled": true`.
   *
   * Binding names capabilities, not plugins — swapping `["github"]` for
   * `["mlflow"]` or `["file-download"]` re-targets annotation storage with no
   * plugin change, which is what makes the owning plugin sink-agnostic.
   */
  "core": {
    "client": {
      "localhost": {
        "io": {
          /* Keys {slideHash}: without it the hash of a guessable slide path
             would be reversible by anyone who can read the repository. */
          "slideHashKey": "<% XOPAT_SLIDE_HASH_KEY %>",
          "bindings": {
            "annotations": {
              "bundle-export": ["github"],
              "bundle-import": ["github"]
            }
          }
        }
      }
    },
    "server": {
      "secure": {
        "proxies": {
          "github": {
            "baseUrl": "https://api.github.com/",
            "headers": {
              "Authorization": "Bearer <% GITHUB_TOKEN %>"
            },
            "auth": {
              "enabled": false,
              "verifiers": ["jwt"],
              "mode": "all",
              "jwt": {
                /* Strip the viewer's JWT before the upstream call: GitHub sees
                   the deployment credential, not the user's identity token. */
                "forward": false,
                "userClaimHeader": "x-user-sub"
              }
            }
          }
        }
      }
    }
  },
  "modules": {
    "io-github-sink": {
      "enabled": true,
      "permaLoad": true,
      "github": {
        "branch": "main",
        "proxy": "github",
        "repo": "<% GITHUB_SINK_REPO %>",
        /* Annotations are slide-scoped: without a slide token every slide
           opened in a viewer would read and write the same file. {slideName}
           is kept out of paths and commit messages: it is the raw file name and
           may carry a case number. */
        "pathTemplate": "xopat/{ownerId}/{viewerId}/{slideHash}.json",
        "commitMessageTemplate": "xopat: sync {ownerId} {viewerId} {slideHash}",
        /* The format each owner's data is stored in. GitHub stores whatever it
           is handed, so this is the operator's choice — without it the owner's
           deployment default applies (and a warning says so). A binding's
           {sink, format} still overrides it. */
        "formats": { "annotations": "native" },
        "committer": null,
        "author": null,
        "auth": null
      }
    },
    "annotations": { "enabled": true, "permaLoad": true }
  },
  "plugins": {
    "gui_annotations": { "enabled": true, "permaLoad": true }
  }
}

*
!*.html
!*.js
!*.json
!*.md
!*.php
# Build needs to recognize git
!.git/
!docs/assets
!docs/*.js
!src
!server
!plugins
!modules
!env
!ui
!/tmp/openseadragon/build
!docker/php/*.conf
!docker/php/*.sh
!.htaccess
!package.json
!package-lock.json
!tailwind.config.js

# Re-exclude compiled C/native build scratch dragged in by !modules.
# buildx rejects the dangling libtool symlinks (e.g. icc_profile lcms2
# .libs/*.la); these intermediates are regenerated by `npm run minify`.
modules/**/build
**/.libs
**/*.la

# Re-exclude deployment config and runtime state dragged in by !env / !server.
# Both are supplied at RUN time (XOPAT_ENV, a read-only mount, or a volume), so
# baking them only serves to put the deployment's live secrets — API keys under
# server.secure, plus whatever sessions the cache happens to hold — into every
# image layer, where they survive `docker save` and any registry push.
# env.default.json is the committed reference and stays. Excluding *.json rather
# than env*.json on purpose — the directory also holds differently-named configs
# (e.g. test-kc-public.env.json), and an allowlist of one is the safer shape.
env/*.json
!env/env.default.json
server/.cache
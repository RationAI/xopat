# allow only built-in items in modules/plugins
# Only top-level entries in modules/ and plugins/ are ignored;
# once a directory below is un-ignored, all of its contents are tracked normally.
/modules/*
!/modules/annotations
!/modules/basic-auth
!/modules/chat
!/modules/demo-vector-layers
!/modules/empaia-wsi-tile-source
!/modules/empaia-workbench
!/modules/fabricjs
!/modules/geotiff
!/modules/geotiff/dist
!/modules/human-readable-ids
!/modules/icc_profile
!/modules/io-github-sink
!/modules/io-mlflow-sink
!/modules/jwt-decode
!/modules/markdown
!/modules/menu-pages
!/modules/mlflow
!/modules/oidc-client-ts
!/modules/oidc-server-ts
!/modules/pathology-foundation
!/modules/rationai-wsi-tile-source
!/modules/recorder
!/modules/saml-auth
!/modules/sanitize-html
!/modules/snapshots
!/modules/speech-to-text
!/modules/vega
!/modules/vega-secure
!/modules/vercel-ai-chat-sdk
!/modules/webgl
!/modules/webtiff
!/modules/webtiff/dist
!/modules/sam-segmentation-experimental
!/modules/web-worker-manager

/plugins/*
!/plugins/annotations
!/plugins/analyze-dev
!/plugins/chat-anthropic
!/plugins/chat-openai-compatible
!/plugins/chat-openai
!/plugins/custom-pages
!/plugins/empaia
!/plugins/empaia-app-ui
!/plugins/extra-tutorials
!/plugins/rationai-wsi-file-browser
!/plugins/navigation-tracker
!/plugins/pathology-medgemma
!/plugins/profiler
!/plugins/questionaire
!/plugins/questionaire-new
!/plugins/recorder
!/plugins/user-session
!/plugins/youtrack-feedback-form
!/plugins/sam-segment-tool-experimental
!/plugins/dicom
!/plugins/dicom-browser
!/plugins/slide-info
!/plugins/slide-scoring

#rubbish
*.txt
*.old
*.temp
.idea/
Thumbs.db

#builds and binaries
*.min.js
*.min.js.map
*.min.mjs
*.min.mjs.map
/openseadragon/
/openseadragon-new/
node_modules/
/build/
/coverage/
# Deployment configuration. `/env/*` rather than `/env/`: excluding the
# directory itself means git never reconsiders anything inside it, so the
# un-ignore rules below would be dead. Everything tracked here must be
# secret-free — `npm run up:check` enforces that for env/parts/.
/env/*
!/env/README.md
!/env/env.default.json
!/env/presets.json
!/env/parts/
dist
tmp

# Vendored decoder payloads. The bare `dist` rule above matches at any depth and
# wins over the module allowlist at the top of this file (last match wins), so
# the directory has to be re-included here — and its contents explicitly, since
# a file inside an excluded directory is never reconsidered.
!/modules/webtiff/dist/
!/modules/webtiff/dist/**

#docs
/docs/build/
!docs/doctemplates/openseadragon

#docs site (Docusaurus) — generated content and build outputs
/docs/site/node_modules/
/docs/site/build/
/docs/site/.docusaurus/
/docs/site/static/api/
/docs/site/docs/generated/

#test suite data
/test/downloads/
/test/screenshots/
/test/videos/
/test/reports/
# Fixture slides and everything derived from them. The slides are fetched and
# checksum-verified against the tracked `test/fixtures/data/manifest.json`; the
# derived overlays and the synthetic pyramid come from tracked code. None of it
# is a source, so committing any of it would only create a second copy to keep
# in sync — and the slides are 3.4 GB.
/test/fixtures/slides/generated/
/test/fixtures/data/slides/
/test/fixtures/data/generated/
/wsi_data

#sensitive data
cypress.env.*

#image comparison test temp data
*.diff.png
*.actual.png

#all hidden files unless explicitly added
.*

# hidden docs file
!.readthedocs.yaml

# The secrets template is tracked; the secrets themselves (env/.env) and the
# composed artifacts (env/.compose/) are not. Must come after the `.*` rule
# above — last match wins.
!/env/.env.example

# CI workflows must stay tracked despite the catch-all dotfile rule above
# (un-ignore the directory, then re-ignore everything but workflows/)
!/.github/
/.github/*
!/.github/workflows/
# GitHub Pages marker served with the docs site
!/docs/site/static/.nojekyll

#ui
ui/index.js
ui/index.js.map
# allow only built-in items in modules/plugins
# Only top-level entries in modules/ and plugins/ are ignored;
# once a directory below is un-ignored, all of its contents are tracked normally.
/modules/*
!/modules/annotations
!/modules/basic-auth
!/modules/chat
!/modules/empaia-wsi-tile-source
!/modules/fabricjs
!/modules/geotiff
!/modules/geotiff/dist
!/modules/human-readable-ids
!/modules/icc_profile
!/modules/io-github-sink
!/modules/io-mlflow-sink
!/modules/jwt-decode
!/modules/menu-pages
!/modules/mlflow
!/modules/oidc-client-ts
!/modules/oidc-server-ts
!/modules/rationai-wsi-tile-source
!/modules/saml-auth
!/modules/sanitize-html
!/modules/snapshots
!/modules/speech-to-text
!/modules/vega
!/modules/vega-secure
!/modules/vercel-ai-chat-sdk
!/modules/webgl
!/modules/webtiff
!/modules/webtiff/dist
!/modules/sam-segmentation-experimental
!/modules/web-worker-manager

/plugins/*
!/plugins/annotations
!/plugins/analyze-dev
!/plugins/chat-anthropic
!/plugins/chat-openai-compatible
!/plugins/chat-openai
!/plugins/custom-pages
!/plugins/empaia
!/plugins/extra-tutorials
!/plugins/rationai-wsi-file-browser
!/plugins/navigation-tracker
!/plugins/pathology-medgemma
!/plugins/profiler
!/plugins/questionaire
!/plugins/recorder
!/plugins/user-session
!/plugins/youtrack-feedback-form
!/plugins/sam-segment-tool-experimental
!/plugins/dicom
!/plugins/slide-info
!/plugins/slide-scoring

#rubbish
*.txt
*.old
*.temp
.idea/
Thumbs.db

#builds and binaries
*.min.js
*.min.js.map
*.min.mjs
*.min.mjs.map
/openseadragon/
/openseadragon-new/
/node_modules/
/build/
/coverage/
/env/
!env/README.md
!env/env.default.json
dist
tmp

# Vendored decoder payloads. The bare `dist` rule above matches at any depth and
# wins over the module allowlist at the top of this file (last match wins), so
# the directory has to be re-included here — and its contents explicitly, since
# a file inside an excluded directory is never reconsidered.
!/modules/webtiff/dist/
!/modules/webtiff/dist/**

#docs
/docs/build/
!docs/doctemplates/openseadragon

#docs site (Docusaurus) — generated content and build outputs
/docs/site/node_modules/
/docs/site/build/
/docs/site/.docusaurus/
/docs/site/static/api/
/docs/site/docs/generated/

#test suite data
/test/downloads/
/test/screenshots/
/test/videos/
/test/reports/
/test/fixtures/slides/generated/
/wsi_data

#sensitive data
cypress.env.*

#image comparison test temp data
*.diff.png
*.actual.png

#all hidden files unless explicitly added
.*

# hidden docs file
!.readthedocs.yaml

# CI workflows must stay tracked despite the catch-all dotfile rule above
# (un-ignore the directory, then re-ignore everything but workflows/)
!/.github/
/.github/*
!/.github/workflows/
# GitHub Pages marker served with the docs site
!/docs/site/static/.nojekyll

#ui
ui/index.js
ui/index.js.map